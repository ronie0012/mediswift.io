{
  "builds": [
    {
      "src": "mediswift_backend/wsgi_application.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "mediswift_backend/wsgi_application.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "mediswift_backend.settings_production"
  }
} 